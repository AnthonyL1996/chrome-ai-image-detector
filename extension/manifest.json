{
  "manifest_version": 3,
  "name": "POIDH Local AI Image Detector",
  "version": "0.1.0",
  "description": "Scan page images locally with a bundled ONNX model; no server or cloud inference.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan page images locally"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
